{
  "name": "fiberos-r14-1-sales-core",
  "version": "1.0.0-rc.1+commercial.2026-09-25",
  "private": true,
  "description": "FiberOS R14.1 sales core source distribution: operational runtime, PostgreSQL/PostGIS schema, and deployment boundaries. Multi-buyer positioning preferred.",
  "workspaces": [
    "packages/*",
    "services/api",
    "services/worker",
    "services/ai",
    "services/gis"
  ],
  "scripts": {
    "api": "node services/api/src/server.js",
    "worker": "node services/worker/src/worker.js",
    "ai": "node services/ai/src/server.js",
    "gis": "node services/gis/src/server.js",
    "migrate": "node scripts/migrate.js",
    "health": "node scripts/health-check.js",
    "verify:production-readiness": "node scripts/production-readiness-gate.js",
    "test": "node --test packages/*/test/*.test.js services/*/test/*.test.js apps/*/test/*.test.js scripts/test/firewall-apply-nft-policy.test.js scripts/test/production-readiness-gate.test.js",
    "verify:formal": "node scripts/verify-formal-verification.js",
    "verify:capabilities": "node scripts/verify-capability-parity.js",
    "verify:root-cause": "node scripts/verify-root-cause-gates.js",
    "verify:domain": "node scripts/verify-domain-neutrality.js",
    "verify:manifest": "node scripts/verify-sales-manifest-generator-contract.js && node scripts/verify-manifest-parity.js && node scripts/release-provenance.js --check",
    "verify": "npm run verify:architecture && npm run verify:architecture-map && npm run verify:syntax && npm run verify:engines && npm run verify:release && npm run verify:union-closure && npm run verify:pre-db-final && npm run verify:migration-sequence && npm run verify:production-console && npm run test:provenance && npm run verify:root-cause && npm run verify:api-authorization && npm run verify:static-security && npm run verify:performance-contract && npm run verify:master-statement && npm run test && npm run verify:formal && npm run verify:capabilities && npm run verify:domain && npm run verify:commercial-consistency && npm run verify:i18n:quality && npm run verify:i18n:atomic && npm run verify:runtime-evidence && npm run verify:evidence-bundle && node scripts/regen-manifest.js && npm run verify:manifest && npm run verify:provenance && npm run verify:archive && npm run verify:commercial",
    "verify:syntax": "node scripts/verify-js-syntax.js",
    "verify:engines": "node scripts/verify-engines-contract.js && node --test scripts/test/engines-contract.test.js",
    "verify:release": "node scripts/verify-release-integrity.js",
    "verify:union-closure": "node scripts/verify-union-closure.js",
    "verify:evidence-bundle": "node scripts/verify-evidence-bundle-integrity.js",
    "verify:pre-db-final": "node scripts/verify-pre-db-final.js",
    "verify:commercial": "node scripts/verify-commercial-release.js",
    "verify:residual-security": "node --test services/api/test/securityResidualFixes.test.js",
    "verify:i18n": "node scripts/verify-i18n.js",
    "verify:i18n:release": "node scripts/verify-i18n.js --require-all-verified && node scripts/verify-i18n-quality.js --require-all-verified --require-runtime-formatting",
    "verify:i18n:quality": "node scripts/verify-i18n-quality.js && node tools/generate-locale-selector-data.js --check",
    "verify:i18n:runtime": "node scripts/verify-i18n-quality.js --require-runtime-formatting",
    "verify:architecture": "node scripts/verify-architecture-boundaries.js",
    "verify:architecture-map": "node tools/generate-architecture-map.js && node scripts/verify-architecture-map.js",
    "generate:architecture-map": "node tools/generate-architecture-map.js",
    "verify:i18n:surgical": "node tools/surgical-translator-validator.js",
    "i18n:selector": "node tools/generate-locale-selector-data.js",
    "verify:migration-sequence": "node scripts/verify-migration-sequence.js && node scripts/verify-docs-migration-alignment.js",
    "verify:production-console": "node scripts/verify-production-console.js",
    "verify:runtime-evidence": "node scripts/runtime-evidence-store-audit.js",
    "website:build": "node scripts/build-netlify-site.js",
    "website:check": "node scripts/verify-netlify-site.js",
    "website:performance": "node scripts/verify-website-performance.js",
    "website:test": "npm run website:build && npm run website:check && npm run website:performance",
    "verify:docs-migration": "node scripts/verify-docs-migration-alignment.js",
    "visual:baseline": "node tools/visual/visual-regression.js --update",
    "visual:check": "node scripts/build-netlify-site.js && node tools/visual/visual-regression.js",
    "verify:archive": "tmp_archive=$(mktemp --suffix=.zip) && python3 scripts/build-delivery-archive.py --output \"$tmp_archive\" --commit \"$(git rev-parse HEAD)\" >/dev/null && python3 scripts/verify-delivery-archive.py \"$tmp_archive\" --commit \"$(git rev-parse HEAD)\" && rm -f \"$tmp_archive\"",
    "verify:i18n:forensic": "node scripts/verify-i18n-forensic-audit.js",
    "verify:i18n:atomic": "node scripts/verify-i18n-atomic-linguistic-audit.js",
    "verify:master-statement": "node scripts/verify-master-statement-coverage.js",
    "verify:api-authorization": "node scripts/verify-api-authorization-matrix.js",
    "verify:static-security": "node scripts/verify-static-security-surface.js",
    "verify:performance-contract": "node scripts/verify-performance-contract.js",
    "verify:commercial-consistency": "node scripts/verify-commercial-consistency.js",
    "verify:provenance": "node scripts/release-provenance.js --check",
    "test:provenance": "node --test scripts/test/release-provenance.test.js scripts/test/release-doc-migration-alignment.test.js scripts/test/capability-parity-route-table.test.js scripts/test/production-readiness-gate.test.js scripts/test/evidence-bundle-integrity.test.js",
    "buyer:runtime-attestation": "node scripts/buyer-acceptance/runtime-go-live-attestation.js",
    "truth:generate": "node scripts/generate-truth.mjs",
    "truth:check": "node scripts/generate-truth.mjs --check"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  }
}
