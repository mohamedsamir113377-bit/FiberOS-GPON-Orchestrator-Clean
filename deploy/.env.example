# FiberOS R14.1 — deploy template. NOT a secret store: copy to .env (git-ignored)
# or, better, write each value into deploy/secrets/*.txt files.
# NEVER place a real password, JWT secret or API key in git or in the delivery ZIP.

# --- runtime ---
NODE_ENV=production
PRODUCTION_HOLD=true
FIBEROS_PRODUCTION_VERIFIED=false

# --- database (three distinct identities, three distinct files) ---
# API/GIS runtime (constrained: fiberos_runtime -> fiberos_app, RLS applies)
FIBEROS_RUNTIME_DATABASE_URL_FILE=/run/secrets/runtime_database_url
# Outbox worker (own credential, never app-role membership)
FIBEROS_WORKER_DATABASE_URL_FILE=/run/secrets/worker_database_url
# Migrator: used ONLY by `npm run migrate`, never mounted into api/worker/gis
MIGRATOR_DATABASE_URL_FILE=/run/secrets/migrator_database_url

# --- TLS to PostgreSQL (production refuses to start without both) ---
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true

# --- identity (real OIDC/JWKS only; no local stub in production) ---
JWT_VERIFY=true
OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
OIDC_ISSUER=https://idp.example/
OIDC_AUDIENCE=fiberos-api
OIDC_JWKS_ALLOWED_HOSTS=idp.example

# --- request security ---
CORS_ORIGIN=https://field.example
SECURITY_HEADERS_ENABLED=true
SECURITY_RATE_LIMIT_PER_MINUTE=120
SECURITY_RATE_LIMIT_BURST=30
SECURITY_RATE_LIMIT_BACKEND=PROCESS_LOCAL
SECURITY_RATE_LIMIT_EXPECTED_INSTANCES=1
# Set explicitly. Enable only for clients that implement the HMAC request contract.
FIBEROS_KERNEL_BOUNDARY_REQUIRED=false
# REDIS mode is fail-closed: Redis outage returns 503 for rate-limited API/AI requests.
# Use a managed HA endpoint with automatic failover, alerts, TLS, and a tested failover;
# production readiness requires a recent Ed25519-signed proof and a live Redis ROLE
# probe showing the configured primary has at least one connected replica.
# The liveness/health routes also pass the edge limiter, so Redis availability is critical.
# For more than one API/AI replica, use a shared managed Redis endpoint with TLS (rediss://)
# and set SECURITY_RATE_LIMIT_BACKEND=REDIS plus REDIS_URL in the secret store.
# REDIS_URL=rediss://user:password@redis.example:6380

# --- replay/idempotency ---
# Protected mutations require shared Redis; failed HTTP responses release the reservation.
FIBEROS_REPLAY_DEFENSE_BACKEND=REDIS
FIBEROS_REPLAY_DEFENSE_REQUIRED=true
FIBEROS_REPLAY_TTL_SECONDS=300
# --- outbox delivery ---
# Either provide OUTBOX_DELIVERY_ADAPTER or use the built-in signed HTTPS adapter.
# OUTBOX_DELIVERY_URL=https://events.example/v1/fiberos/events
# OUTBOX_DELIVERY_SECRET=REPLACE_ME
OUTBOX_DELIVERY_TIMEOUT_MS=10000
# FIBEROS_REDIS_HA_PROOF_FILE=/run/secrets/fiberos-redis-ha-proof.json
# FIBEROS_REDIS_HA_PROOF_PUBLIC_KEY_FILE=/run/config/fiberos-redis-ha-proof-ed25519.pub
# FIBEROS_REDIS_HA_PROOF_KEY_ID=approved-infra-ci-key-2026

# --- translation engine (isolated profile; no DB credential by design) ---
SOURCE_LOCALE=source
TARGET_KEY_COUNT=101
TRANSLATION_FAIL_CLOSED=true

# --- pools / timeouts ---
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
