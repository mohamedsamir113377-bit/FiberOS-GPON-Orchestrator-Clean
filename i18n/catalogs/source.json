    "ui.4372918e9883": "Required Skill",
    "ui.ea8d2734f5d9": "SLA Deadline",
    "ui.6e7d50e84f47": "Result",
    "ui.fd9cf6c9b415": "Feature Assurance / HTML Parity",
    "ui.f1a80e3e8395": "This is not a cosmetic screen. The list below is built from the attached HTML reference and classifies each capability based on implementation evidence in the repository. A feature name does not mean the feature is complete.",
