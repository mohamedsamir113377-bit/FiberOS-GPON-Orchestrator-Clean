    "ui.5854ffc6682f": "Executive / Finance",
    "ui.1e22c22f5622": "Accounting readout from PostgreSQL only. There is no autonomous AI CEO, no independent financial execution, and no simulated results presented as fact.",
    "ui.046c9378f8f3": "FiberOS Enterprise Command Center — Alpha81",
    "ui.734805bbe64e": "FIBEROS / ENTERPRISE OPERATING SYSTEM",
