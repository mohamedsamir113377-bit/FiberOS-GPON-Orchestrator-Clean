    "ui.6ef29d0b15c8": "FTTH Workflow",
    "ui.82b3e49eb975": "Planning → GIS → BOQ → Approval → Civil → Cable → Splicing → Optical Test → QC → Acceptance → Drop → ONT → Router → Activation",
    "ui.1bd41c8b8b5a": "Company President → Deputies → Sector Heads → Sector Head → General Manager → Central Office Manager → Team Leader → Technician",
    "ui.53843646caad": "Received → Reserved → Issued → Transferred → Installed/Consumed → Returned/Damaged/Scrapped",
    "ui.0353ca64634b": "API Check",
    "ui.ddf413a199e7": "This surface does not fabricate numbers: when the API/DB is unavailable, it shows an unavailable state instead of fake data.",
    "ui.833c3759a177": "FiberOS Field Tech — Alpha47",
    "ui.f272249f67c9": "📷 FiberOS Field Tech",
