# FiberOS R14.1 Sales Core — safe template only.
# Never commit credentials. Use a protected secret/configuration store.
NODE_ENV=production

# Fail-closed production admission. Keep the hold active until live verification.
PRODUCTION_HOLD=true
FIBEROS_PRODUCTION_VERIFIED=false
FIBEROS_PRODUCTION_ATTESTATION_FILE=config/production-readiness-attestation.json

# API runtime database login (must NOT be the migration credential).
DATABASE_URL_FILE=/run/secrets/runtime_database_url
# Worker runtime database login (separate credential).
DATABASE_WORKER_URL_FILE=/run/secrets/worker_database_url
# Used only by the migration command; never mount it into API/worker containers.
MIGRATOR_DATABASE_URL_FILE=/run/secrets/migrator_database_url

# Live RLS / adversarial DB runtime evidence harnesses (disposable CI-only
# credentials; never real production secrets). Canonical names, read verbatim
# by scripts/buyer-acceptance/live-postgres-rls.js,
# scripts/buyer-acceptance/ftth-audit-rls-semantic-audit.js and
# deploy/tests/tenant_isolation.sh:
#   RUNTIME_ADMIN_DATABASE_URL - admin/DBA connection used for bootstrap+probes
#   RUNTIME_APP_DATABASE_URL   - constrained fiberos_runtime connection
# scripts/buyer-acceptance/adversarial-db-runtime-audit.js and
# scripts/buyer-acceptance/adversarial-tenant-fk-mutation-audit.js additionally
# accept the ADMIN_URL / APP_URL aliases (same values) exactly as injected by
# .github/workflows/runtime-postgres-rls.yml.
# RUNTIME_ADMIN_DATABASE_URL=
# RUNTIME_APP_DATABASE_URL=

API_PORT=8080
API_BIND_HOST=127.0.0.1
WORKER_INTERVAL_MS=5000

# Production identity: real OIDC/JWKS only.
JWT_VERIFY=true
OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
OIDC_ISSUER=https://idp.example/
OIDC_AUDIENCE=fiberos-api
OIDC_JWKS_ALLOWED_HOSTS=idp.example

# PostgreSQL TLS.
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
FIBEROS_TLS_EXPECTED_ORIGIN=https://api.example.invalid
# Probe URL must have the exact origin above; a path such as /health is allowed.
FIBEROS_TLS_PROBE_URL=https://api.example.invalid/health

# Browser/security boundary.
CORS_ORIGIN=https://example.invalid
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_FIREWALL_ENABLED=true
# Optional edge deny-list (comma-separated CIDRs). Empty = no IP deny.
SECURITY_FIREWALL_DENY_CIDRS=
# Optional Host allow-list (comma-separated hostnames). Empty = any Host.
SECURITY_ALLOWED_HOSTS=
SECURITY_MAX_QUERY_LENGTH=4096
SECURITY_MAX_URL_LENGTH=8192
SECURITY_REQUIRE_HTTPS=true
SECURITY_RATE_LIMIT_PER_MINUTE=120
# Application-layer DDoS / concurrency flood guard (not a CDN volumetric shield).
SECURITY_DDOS_GUARD_ENABLED=true
SECURITY_DDOS_MAX_CONCURRENT_PER_IP=32
SECURITY_DDOS_MAX_GLOBAL_CONCURRENT=512
SECURITY_DDOS_MAX_REQUESTS_PER_WINDOW=120
SECURITY_DDOS_RATE_WINDOW_MS=1000
SECURITY_RATE_LIMIT_BURST=30
SECURITY_RATE_LIMIT_BACKEND=PROCESS_LOCAL
SECURITY_RATE_LIMIT_EXPECTED_INSTANCES=1
# For production REDIS mode, supply a signed HA proof plus a separately pinned
# Ed25519 public key file and expected key ID; the readiness gate also probes ROLE.
# FIBEROS_REDIS_HA_PROOF_FILE=/run/secrets/fiberos-redis-ha-proof.json
# FIBEROS_REDIS_HA_PROOF_PUBLIC_KEY_FILE=/run/config/fiberos-redis-ha-proof-ed25519.pub
# FIBEROS_REDIS_HA_PROOF_KEY_ID=approved-infra-ci-key-2026
SECURITY_MAX_BODY_BYTES=262144
SECURITY_MAX_BODY_JSON=524288
SECURITY_MAX_BODY_UPLOAD=8388608

# Field evidence freshness.
PHOTO_MAX_AGE_SECONDS=900

# Optional vendor/runtime adapters.
NMS_VENDOR=
NMS_BASE_URL=
NMS_API_KEY=

# Optional AI/GIS/routing integrations. AI remains disabled until an operator
# deploys a model runtime and explicitly enables it. AI-only outbound policy
# rejects public IP destinations even when a hostname is allowlisted.
AI_ENABLED=false
# OpenAI-compatible private/internal inference endpoint for every AI advice path.
FIBEROS_AI_INFERENCE_URL=
FIBEROS_AI_MODEL_ID=
FIBEROS_SELF_HOSTED_HOSTS=
FIBEROS_SELF_HOSTED_CIDRS=
FIBEROS_GIS_SERVICE_URL=
FIBEROS_CONTACT_ARI_URL=
FIBEROS_VALHALLA_URL=
FIBEROS_OSRM_URL=

# Distributed replay defense / interactive OIDC session boundary
FIBEROS_REPLAY_DEFENSE_BACKEND=REDIS
FIBEROS_REPLAY_DEFENSE_REQUIRED=true
FIBEROS_REPLAY_REDIS_PREFIX=fiberos:replay:v1
FIBEROS_REPLAY_TTL_SECONDS=300
FIBEROS_REPLAY_PROTECTED_ROUTES=/v1/tickets/close-field,POST;/v1/evidence/submit,POST;/v1/sync/batch,POST;/v1/billing/invoices,POST;/v1/billing/payment-cycle,POST;/v1/ops/rework-cases,POST
CORS_ALLOW_CREDENTIALS=true

# Inject exact resource identity from the deployment's protected configuration; do not reuse a sample ID.
FIBEROS_REDIS_HA_RESOURCE_ID=
# Inject the exact immutable CI commit/tag used to deploy this resource.
FIBEROS_REDIS_HA_BUILD_REF=

FIBEROS_OIDC_ISSUER_URL=https://idp.example.com
FIBEROS_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
FIBEROS_OIDC_CLIENT_ID=fiberos-ops
FIBEROS_OIDC_CLIENT_SECRET=
FIBEROS_OPS_API_BASE_URL=https://api.ops.example.com
FIBEROS_OPS_WEB_ORIGIN=https://ops.example.com
FIBEROS_OPS_WEB_DASHBOARD_URL=https://ops.example.com/
FIBEROS_OIDC_STATE_TTL_SECONDS=600
FIBEROS_OIDC_SESSION_TTL_SECONDS=3600
# Deep operational GIS / routing
# Use an operator-controlled/self-hosted style in production; public OpenFreeMap is a development/commercial fallback without SLA.
FIBEROS_MAP_STYLE_URL=
FIBEROS_GIS_SERVICE_URL=

# Routing provider boundary. The API fails closed when ROUTING_BASE_URL is absent.
# Supported server adapter values: osrm, valhalla.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=
ROUTING_ALLOWED_HOSTS=
ROUTING_ALLOWED_CIDRS=
ROUTING_TIMEOUT_MS=10000
ROUTING_MAX_RESPONSE_BYTES=2097152
